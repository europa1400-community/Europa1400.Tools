{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "restore",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "restore",
                "Europa1400.Tools.sln"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "Europa1400.Tools.sln",
                "--no-restore"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "restore"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "Europa1400.Tools.sln",
                "--no-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "build"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run verifier",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "Europa1400.Tools.Verifier",
                "--no-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "build"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
