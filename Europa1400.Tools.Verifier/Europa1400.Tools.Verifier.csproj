<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Europa1400.Tools.Verifier</RootNamespace>
    <ApplicationTitle>Europa1400 Tools Verifier</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Europa1400.Tools\Europa1400.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Europa1400.Tools.Verifier.Tests" />
  </ItemGroup>
</Project>
